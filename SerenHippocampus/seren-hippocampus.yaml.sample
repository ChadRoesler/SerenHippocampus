# SerenHippocampus config - copy to ~/seren-hippocampus/seren-hippocampus.yaml
#
# The hippocampus is SerenMemory's sleep cycle, split out. It holds no store:
# it reads short-terms from Memory, writes drafts to Memory, and purges what
# was flagged. Two loops: sleep (~20h) and tend (every few minutes, picks up
# denied operations and resubmits them).

server:
  host: 127.0.0.1        # local-only. 0.0.0.0 = reachable on the LAN - set a bearer first
  port: 7424             # the last slot in the brain band
  # The bearer THIS service requires of callers (its /sleep, /tend, /status,
  # and /mcp - the main model's tools, served when the [mcp] extra is
  # installed: sleep_status, sleep_now, tend_now, check_now, sleep_history,
  # audit_sleeps, list_replays, replay_draft. SEREN_HIPPOCAMPUS_MCP_MOUNT moves it).
  # bearer_token: ""                                # inline literal - escape hatch
  # bearer_token_env: SEREN_HIPPOCAMPUS_TOKEN       # NAME of an env var (recommended)
  # bearer_token_keyring: "seren-hippocampus/bearer"

memory:
  url: http://127.0.0.1:7420
  # The bearer the hippocampus presents TO Memory. A Memory installed with
  # --gen-token answers 401 to everything without one. Same three pointers.
  # bearer_token_env: SEREN_MEMORY_TOKEN
  # bearer_token_keyring: "seren-memory/bearer"
  # bearer_token: ""
  timeout_seconds: 30

model:
  # The small model - the Inside Out workers. OpenAI-compatible
  # /v1/chat/completions; a 2B-4B model is plenty. Empty url = mechanical
  # mode: clusters over the threshold become new cores by the longest entry,
  # verbatim flags are honoured, and no attach / supersede is proposed,
  # because those are judgement calls.
  url: http://localhost:8090/v1
  name: default
  timeout_seconds: 120
  # The cap on one answer. Too low and an answer is cut off mid-operation: the
  # operations it finished are kept and the sleep report counts it (cut_off),
  # but the rest is lost until the next sleep. A drafting prompt is about 1,900
  # tokens, so keep prompt + this under the context the server was started with.
  max_tokens: 2000
  # Start the model only when a sleep or a redraft needs it, stop it after.
  # For a Nano floor or a small card: the drafting model is not loaded all day.
  lifecycle:
    # The easy way: name the server and the model file. The hippocampus builds
    # <server> -m <model_path> --host/--port (from url above) <server_args>,
    # and naming both turns management on.
    # server: "C:\\llama\\llama-server.exe"          # or ~/llama.cpp/build/bin/llama-server on a node
    # model_path: "C:\\models\\qwen3-4b-q5.gguf"
    # server_args: "-ngl 99 -c 8192"                  # the default; add -fa on, cache types, threads...
    # Or the whole line by hand (wins over the two above; needs manage: true):
    manage: false
    # start:"C:\\llama\\llama-server.exe -m C:\\models\\qwen3-1.7b-q4.gguf --port 8090 -ngl 99"
    # stop: ""                 # blank = stop the process the hippocampus started
    # observatory_url: http://127.0.0.1:7777      # or: a service the node's Observatory manages
    # observatory_service: seren-llama
    # observatory_token_env: SEREN_OBSERVATORY_TOKEN
    # health_url: ""           # blank = the model url without /v1, plus /health
    ready_timeout_seconds: 240
    keep_warm_seconds: 300     # stays up this long after its last call, then stops on the next tick
                               # (and at once when no chain is open: the cycle is over)
    # handover: true           # one model in memory at a time (a Nano): stop the small model BEFORE
                               # the main model is poked to review, instead of keeping it warm
    retry_after_seconds: 900   # after a failed start, wait this long before trying again

sleep:
  mode: thread             # thread = loops in-process; external = POST /sleep and /tend yourself
  interval_seconds: 72000  # bedtime: ~20h after the last sleep (not 24, on purpose: it drifts through the day)
  # at: "03:30"            # or a wall-clock time (local HH:MM) instead of the interval
  warmup_seconds: 300      # a process that boots overdue sleeps this soon, not a whole interval later
  gap_grace_intervals: 3   # a sleep after a gap this long (x interval) drafts but does not age out or sweep
  # The brief is the gate. Every tick the hippocampus checks Memory for an open brief and
  # sleeps on it. Past bedtime (interval_seconds / at) with none, it counts the misses:
  brief_request: true      # ...and every brief_check_misses of them asks the main model for one
  brief_check_misses: 3    #    (a near-term intent in Memory + a brief_requested event; a nudge after that)
  brief_pull: false        # headless (no main model): let the small model pull a brief from the fragments
  # The heartbeat: how often the loop turns. Cheap - it closes chains that
  # landed and looks for a brief - and it never starts the small model.
  tick_seconds: 300
  # The tend cycle: redrafting what the reviewer denied, which DOES start the
  # small model. true = every tend_interval_seconds. false = only at sleep
  # time (bedtime passing, or a new brief), for a box where the small model
  # and the main model share memory. tend_now by hand redrafts either way,
  # and so does a nudge ("your turn": POST /nudge, or the MCP tool), which is
  # how the main model moves the cycle along without waiting for a timer.
  tend_cycle: true
  tend_interval_seconds: 600
  nudge_wait_seconds: 180  # a nudged turn waits this long for the session that sent it to end
  max_entries_per_run: 500
  promote_min_evidence: 3  # short-terms a topic needs before it is proposed (hints, pins, verbatim override)
  max_attempts: 3          # drafts per chain before the last one is submitted terminal
  candidate_cores: 5       # existing cores shown to the model per cluster
  state_path: ~/.seren-hippocampus/state.json

notify:
  # Where to say that something happened. Events are always kept on the
  # service (GET /events and the viewer); a webhook gets each one POSTed as
  # JSON - Lodestar, Symposium, or a messaging bridge sits at the other end.
  # webhook_url: http://127.0.0.1:6361/hooks/hippocampus
  # bearer_token_env: SEREN_HIPPOCAMPUS_WEBHOOK_TOKEN
  events: [draft_submitted, sleep_failed, chain_ended, purged]
  timeout_seconds: 10

ripple:
  # Where notify is the record, the ripple is the question: when bedtime comes
  # (brief_requested), or a draft or redraft is waiting for review, the
  # hippocampus asks the model instead of waiting to be remembered.
  #   script   - run a command. {message}, {event} and {draft_id} are filled
  #              per argument; the event also arrives in SEREN_RIPPLE_EVENT,
  #              SEREN_RIPPLE_MESSAGE and SEREN_RIPPLE_JSON. Never run by a shell.
  #   endpoint - POST the event and its message to url, with the bearer.
  # The command runs as this service's account: a CLI whose login lives in a
  # user profile (claude, for one) needs the service to run as that user, and
  # its memory tools pre-approved so a headless run doesn't stop at a prompt.
  type: ""                        # "" (off) | script | endpoint
  command: ["claude", "-p", "{message}"]
  # url: http://127.0.0.1:6361/hooks/ripple
  # bearer_token_env: SEREN_HIPPOCAMPUS_RIPPLE_TOKEN
  events: [brief_requested, draft_submitted, tend_resubmitted]
  timeout_seconds: 900
  # messages:                     # override the wording per event
  #   brief_requested: "It's bedtime - want to write a brief?"

voice:
  # The voice card: a short text the main model writes about itself - its
  # voice, its pronouns, whose experience is whose - that every draft and
  # redraft prompt carries, so a small drafting model writes its memories the
  # way it would, not as a third-person case file. Opt in. The card is never
  # written here: the model writes it (set_voice_card over MCP, or PUT /voice),
  # and every version is kept beside the state file, in voice.json.
  enabled: false
  max_chars: 1500                 # it rides in every prompt a small model reads
